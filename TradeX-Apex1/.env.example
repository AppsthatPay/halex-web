# .env.example — TradeX-Apex1 secrets template

# Copy this file to `.env` (or place values in your OS keychain / secrets
# manager) and fill in YOUR OWN values. This file ships with placeholders
# only. Never commit the filled-in version. Never paste real keys into chat,
# logs, or issues.
#
# File permission on your secrets: 600 (owner read/write only).

# --- Codex (blockchain data API, docs.codex.io) ---
# Used by: signal-follower, allen3, allen4, allen5, codex-wallet, test01-codex
# How to get: create an account at dashboard.codex.io, complete the one-time
# $1 activation, create an API key. Auth = raw key in the `Authorization`
# header (no "Bearer" prefix).
CODEX_API_KEY=YOUR_KEY_HERE

# --- Solana keypair: TEST01 seat ---
# Used by: mwts_executor.py, test01-newapi/live_exec.py (ONLY when armed)
# How to get: run `solana-keygen new -o ~/.config/apex2/test01-wallet.json`
# Keep 600. Fund it yourself; start tiny. The system never funds wallets.
TEST01_SOLANA_KEYPAIR_PATH=~/.config/apex2/test01-wallet.json

# --- EVM key: AllenX live seat ---
# Used by: allenx_live_bridge.py (the single armed live loop — ships DISARMED)
# How to get: generate a fresh EVM keypair and store it with 600 permissions.
# AllenX trades a maximum of $2 per trade; fund accordingly and no more.
ALLENX_EVM_KEYPAIR_PATH=~/.config/apex2/allenx-wallet.json

# --- EVM key: Allen2 live seat (disarmed by default) ---
# Used by: allen2_live_bridge.py — ships DISARMED. Leave empty until you
# deliberately arm it.
ALLEN2_EVM_KEYPAIR_PATH=~/.config/apex2/evm-wallet.json

# --- Earnings sweep target (your own address) ---
# Used by: allenx_live_bridge.py — 75% of realized earnings sweep here once
# realized earnings reach $200. Must be an address YOU control.
SWEEP_TARGET_EVM_ADDRESS=YOUR_ADDRESS_HERE

# --- Public RPC endpoints (optional overrides; defaults are public) ---
# Used by: all Solana and Base/EVM modules. Defaults work without keys.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
BASE_RPC_URL=https://mainnet.base.org

# --- Optional future feeds (not required for core build) ---
# HELIUS_API_KEY=YOUR_KEY_HERE        # Solana webhooks / enhanced RPC
# BIRDEYE_API_KEY=YOUR_KEY_HERE       # Solana market data (free tier: 30k CU/mo)
# ALTFINS_API_KEY=YOUR_KEY_HERE       # altFINS signals (free signup)
